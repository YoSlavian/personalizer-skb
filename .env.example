# Скопируйте в .env и заполните. Файл .env не коммитьте.

# --- Режим ---
# development | test | production
ENVIRONMENT=development
# Демо-режим: синтетические учётки, выбор демо-роли в Mini App и боте. Для боевого контура — false.
DEMO_MODE=true
# Заполнить синтетику при старте контейнера (только если БД пустая)
SEED_DEMO=true

# --- База данных ---
# Docker Compose подставит DATABASE_URL сам. Для локального запуска без Docker:
#   SQLite (по умолчанию, ничего задавать не нужно)
#   PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/personalizer
# DATABASE_URL=
POSTGRES_PASSWORD=change-me-strong-password

# --- Telegram ---
# Токен от @BotFather. Никогда не коммитьте и не передавайте во фронтенд.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ (если не задано — определится автоматически при старте)
TELEGRAM_BOT_USERNAME=
# polling — локально без публичного адреса; webhook — сервер с HTTPS; off — бот выключен
TELEGRAM_MODE=polling
# Секрет вебхука (1–256 символов A-Z a-z 0-9 _ -). Сгенерируйте: python -c "import secrets;print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Публичный HTTPS-адрес. Mini App откроется по {PUBLIC_BASE_URL}/miniapp, вебхук — {PUBLIC_BASE_URL}/api/telegram/webhook
PUBLIC_BASE_URL= cloudflared tunnel --url http://localhost:8000
# Срок годности initData Mini App, секунд
TELEGRAM_INIT_DATA_TTL_SECONDS=86400
# HTTP-прокси для запросов бота, если api.telegram.org недоступен из сети сервера (иначе пусто)
TELEGRAM_PROXY=

# --- Безопасность и сессии ---
# В production за HTTPS обязательно true
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
MINIAPP_SESSION_TTL_HOURS=6
RATE_LIMIT_PER_MINUTE=240
LOGIN_ATTEMPTS_PER_WINDOW=5
LOGIN_WINDOW_SECONDS=300
# Отдельный фронтенд в разработке (Vite). В production фронтенд отдаётся с того же домена.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Адаптивный путь ---
# Пауза в калькуляторе до подсказки в демо (в правилах продукта — 45 с)
JOURNEY_IDLE_SECONDS=8

# --- Интеграции (необязательно) ---
# Реальный API оптимизатора банка (контракт — в backend/app/integrations/optimizer.py). Пусто — mock.
OPTIMIZER_API_URL=
OPTIMIZER_API_TOKEN=

# Для docker compose --profile https
DOMAIN=
